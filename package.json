{
	"name": "tanstack-start-on-cloudflare",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.7",
	"engines": {
		"node": ">=24.18.0"
	},
	"scripts": {
		"prepare": "simple-git-hooks",
		"init-project": "tsx scripts/init-project.ts",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:staging": "CLOUDFLARE_ENV=staging vite build --mode staging",
		"build:production": "CLOUDFLARE_ENV=production vite build --mode production",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:staging": "pnpm run build:staging && wrangler deploy --env=''",
		"deploy:production": "pnpm run build:production && wrangler deploy --env=''",
		"serve": "vite preview",
		"cf-typegen": "wrangler types --env-interface BaseEnv",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"types": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"knip": "knip",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"deps": "taze -r",
		"deps:update": "taze -r -w",
		"deps:major": "taze -r major",
		"deps:major:update": "taze -r major -w",
		"db:generate:dev": "drizzle-kit generate --config drizzle-dev.config.ts",
		"db:generate:staging": "drizzle-kit generate --config drizzle-staging.config.ts",
		"db:generate:production": "drizzle-kit generate --config drizzle-production.config.ts",
		"db:migrate:dev": "wrangler d1 migrations apply DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
		"db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
		"db:seed:dev": "wrangler d1 execute DB --local --file scripts/seed-dev.sql",
		"db:list:dev": "wrangler d1 migrations list DB --local"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@radix-ui/react-collapsible": "^1.2.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.4",
		"@tanstack/react-query-devtools": "^5.104.4",
		"@tanstack/react-router": "^1.170.25",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.2",
		"lucide-react": "^0.476.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite-tsconfig-paths": "^5.1.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-v8": "^4.1.12",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^26.1.0",
		"knip": "^6.42.0",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.14.0",
		"taze": "^19.17.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "7.1.2",
		"vitest": "^4.1.12",
		"wrangler": "^4.151.2"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run cf-typegen && pnpm run types && pnpm run knip"
	}
}
