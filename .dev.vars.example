CLOUDFLARE_ENV=dev
# Cloudflare Turnstile secret key, spent against siteverify by POST /api/signatures.
# This is Cloudflare's official always-pass TEST secret: it approves every token,
# which is what lets a fresh clone sign without a Cloudflare account. Replace it
# with a real key from the Turnstile dashboard before collecting real signatures
# (README -> "Turnstile keys"), and set it with `wrangler secret put` per environment.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
